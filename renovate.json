{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "renovate",
    "dependencies"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+\\.ya?ml$/",
      "/infrastructure/.+\\.ya?ml$/",
      "/clusters/.+\\.ya?ml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/apps/.+\\.ya?ml$/",
      "/infrastructure/.+\\.ya?ml$/",
      "/clusters/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "Disable automerge for homelab safety",
      "matchManagers": [
        "kubernetes",
        "flux"
      ],
      "automerge": false
    },
    {
      "description": "Disable major updates for Kubernetes images",
      "matchManagers": [
        "kubernetes"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Disable major updates for Flux Helm charts",
      "matchManagers": [
        "flux"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
